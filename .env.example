# Supabase — public (client + server). Safe to expose to the browser.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your_project_id"

SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="your_project_id"

# Supabase — SERVER ONLY secret. Required by the contact form route
# (src/routes/api/public/contact.ts). NEVER prefix with VITE_ and never
# expose to the client. Get it from Supabase dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
